{
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "indifit-d5f8d",
          "appId": "1:568521959692:android:dd443a19b4159341900129",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "ios": {
        "default": {
          "projectId": "indifit-d5f8d",
          "appId": "1:568521959692:ios:c2cd9fdc1131914b900129",
          "uploadDebugSymbols": false,
          "fileOutput": "ios/Runner/GoogleService-Info.plist"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "indifit-d5f8d",
          "configurations": {
            "android": "1:568521959692:android:dd443a19b4159341900129",
            "ios": "1:568521959692:ios:c2cd9fdc1131914b900129"
          }
        }
      }
    }
  },
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "/catalog/v1/manifest.json",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/catalog/v1/**/*.json.gz",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      }
    ]
  }
}
